          {
            "displayName": "time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT ts AS \"Alert time\", alert_code AS \"Code\", severity AS \"Severity\", subsystem AS \"Subsystem\", description AS \"Description\", is_active AS \"Active\", alert_is_ignored(vin, alert_code) AS \"Ignored\", COALESCE(vehicle_speed_at_alert::text, '-') AS \"Speed\", COALESCE(charge_state_at_alert, '-') AS \"Charge\", COALESCE(battery_level_at_alert::text, '-') AS \"SOC %\" FROM parsed_alerts WHERE vin = '$vin' AND $__timeFilter(ts) ORDER BY ts DESC LIMIT 200",
          "format": "table"
        }
      ]
    },
