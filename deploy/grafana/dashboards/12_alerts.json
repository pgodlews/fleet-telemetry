        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT bucket AS time, SUM(alert_count) FILTER (WHERE subsystem='BMS') AS \"BMS\", SUM(alert_count) FILTER (WHERE subsystem='Drive Inverter') AS \"Drive Inverter\", SUM(alert_count) FILTER (WHERE subsystem='User Interface') AS \"UI\", SUM(alert_count) FILTER (WHERE subsystem='Power Conversion') AS \"PCS\", SUM(alert_count) FILTER (WHERE subsystem='Chassis') AS \"Chassis\", SUM(alert_count) FILTER (WHERE subsystem='Climate Control') AS \"Climate\", SUM(alert_count) FILTER (WHERE subsystem='Charge Port') AS \"Charge Port\" FROM alert_frequency_1d WHERE vin = '$vin' AND $__timeFilter(bucket) GROUP BY bucket ORDER BY bucket",
          "format": "time_series"
        }
      ]
    },
