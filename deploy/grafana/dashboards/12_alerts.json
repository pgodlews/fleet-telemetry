      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT alert_code AS \"Code\", severity AS \"Severity\", subsystem AS \"Subsystem\", first_seen AS \"First seen\", last_seen AS \"Last seen\", recurrence_count AS \"Count\", active_count AS \"Active now\", alert_is_ignored(vin, alert_code) AS \"Ignored\", LEFT(description, 80) AS \"Description\" FROM alert_history_summary WHERE vin = '$vin' ORDER BY CASE severity WHEN 'CRITICAL' THEN 1 WHEN 'URGENT' THEN 2 WHEN 'WARNING' THEN 3 ELSE 4 END, recurrence_count DESC",
          "format": "table"
        }
      ]
    },
