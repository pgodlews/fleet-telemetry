      "description": "Stacked daily alert counts by subsystem. Spikes indicate emerging issues.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisColorMode": "text",
