      "description": "Full parsed alerts with telemetry context at time of alert. Ignored = the code is ignored for this vehicle (pm_alert_ignore); such alerts are never active.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
