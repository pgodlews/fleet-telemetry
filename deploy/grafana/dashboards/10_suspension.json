          "rawSql": "SELECT steering_avg AS \"Steering angle (°)\", lat_accel_avg AS \"Lateral accel (g)\" FROM suspension_samples_1m WHERE vin = '$vin' AND speed_avg > 50 AND ABS(lat_accel_avg) < 0.10 AND steering_avg IS NOT NULL AND $__timeFilter(bucket) ORDER BY bucket",
          "format": "table"
        }
      ]
