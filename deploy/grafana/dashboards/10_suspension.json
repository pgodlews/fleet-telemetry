              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "°"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT ts AS time, lat_accel_stddev AS \"Daily std-dev (g)\", lat_std_30d_avg AS \"30-day avg\", lat_std_90d_avg AS \"90-day avg\" FROM suspension_diagnostics WHERE vin = '$vin' AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series"
        }
      ]
    },
    {
      "id": null,
      "type": "timeseries",
      "title": "Highway Lateral Acceleration",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "description": "1-minute average lateral acceleration on the highway (speed > 50). A persistent offset from zero on straight roads hints at drift. (The steering-angle scatter was removed: SteeringAngle is not a Fleet Telemetry field.)",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 3
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
