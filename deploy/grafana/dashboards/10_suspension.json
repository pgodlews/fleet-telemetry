    {
      "id": null,
      "type": "stat",
      "title": "Overall Status",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "description": "Combined status: SUSPENSION_SERVICE_REQUIRED when UI_a006 (chassis/alignment) is active, SUSPENSION_LOOSENESS_LIKELY from rising lateral-acceleration variance, NO_DATA without recent highway driving.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "NORMAL": {
                  "color": "green",
                  "index": 0,
                  "text": "NORMAL"
                },
                "SUSPENSION_LOOSENESS_LIKELY": {
                  "color": "yellow",
                  "index": 1,
                  "text": "LOOSENESS LIKELY"
                },
                "SUSPENSION_ALIGNMENT_LIKELY": {
                  "color": "orange",
                  "index": 2,
                  "text": "ALIGNMENT LIKELY"
                },
                "SUSPENSION_SERVICE_RECOMMENDED": {
                  "color": "red",
                  "index": 3,
                  "text": "SERVICE RECOMMENDED (URGENT)"
                },
                "SUSPENSION_SERVICE_REQUIRED": {
                  "color": "dark-red",
                  "index": 4,
                  "text": "SERVICE REQUIRED (CRITICAL)"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": ""
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^overall_status$/",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT overall_status FROM suspension_summary WHERE vin = '$vin'",
          "format": "table"
        }
      ]
    },
