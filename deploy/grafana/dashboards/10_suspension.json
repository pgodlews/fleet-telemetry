      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "description": "Recent highway trips: straight-line minutes and lateral-acceleration drift / std-dev.",
      "fieldConfig": {
        "defaults": {
