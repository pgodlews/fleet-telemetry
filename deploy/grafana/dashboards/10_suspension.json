        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT alert_code AS \"Alert\", severity AS \"Severity\", description AS \"Description\", started_at AS \"Started\" FROM suspension_alerts WHERE vin = '$vin' AND ended_at IS NULL ORDER BY CASE severity WHEN 'CRITICAL' THEN 1 WHEN 'URGENT' THEN 2 WHEN 'WARNING' THEN 3 ELSE 4 END, started_at DESC",
          "format": "table"
