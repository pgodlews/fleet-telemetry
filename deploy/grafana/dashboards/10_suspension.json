        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT bucket AS time, lat_accel_avg AS \"Lateral accel (g)\" FROM suspension_samples_1m WHERE vin = '$vin' AND speed_avg > 50 AND $__timeFilter(bucket) ORDER BY bucket",
          "format": "table"
        }
      ]
    },
