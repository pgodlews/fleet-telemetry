        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT started AS \"Trip start\", distance_km AS \"Distance (km)\", max_speed_mph AS \"Max speed (mph)\", straight_highway_minutes AS \"Straight min\", ROUND(lat_accel_drift::numeric, 4) AS \"Mean drift (g)\", ROUND(lat_accel_stddev::numeric, 4) AS \"Std-dev (g)\" FROM suspension_trip_offsets WHERE vin = '$vin' ORDER BY started DESC LIMIT 50",
          "format": "table"
        }
      ]
    },
