    {
      "id": 13,
      "type": "stat",
      "title": "Security & state",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  max(CASE WHEN field='Locked' THEN CASE str_value WHEN 'true' THEN 'Locked' WHEN 'false' THEN 'Unlocked' END END) AS \"Lock\",\n  max(CASE WHEN field='SentryMode' THEN replace(str_value, 'SentryModeState', '') END) AS \"Sentry\",\n  max(CASE WHEN field='PinToDriveEnabled' THEN CASE str_value WHEN 'true' THEN 'On' WHEN 'false' THEN 'Off' END END) AS \"PIN to Drive\",\n  max(CASE WHEN field='ValetModeEnabled' THEN CASE str_value WHEN 'true' THEN 'On' WHEN 'false' THEN 'Off' END END) AS \"Valet\",\n  max(CASE WHEN field='GuestModeEnabled' THEN CASE str_value WHEN 'true' THEN 'On' WHEN 'false' THEN 'Off' END END) AS \"Guest\",\n  max(CASE WHEN field='ServiceMode' THEN CASE str_value WHEN 'true' THEN 'On' WHEN 'false' THEN 'Off' END END) AS \"Service mode\",\n  max(CASE WHEN field='LightsHazardsActive' THEN CASE str_value WHEN 'true' THEN 'On' WHEN 'false' THEN 'Off' END END) AS \"Hazards\"\nFROM telemetry_latest\nWHERE vin='$vin' AND field IN ('Locked','SentryMode','PinToDriveEnabled','ValetModeEnabled','GuestModeEnabled','ServiceMode','LightsHazardsActive')"
        }
      ],
      "description": "Snapshot of security and occupancy-related boolean fields.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "not reported",
          "mappings": [
            {
              "type": "value",
              "options": {
                "Locked": {
                  "text": "Locked",
                  "color": "green",
                  "index": 1
                },
                "Unlocked": {
                  "text": "Unlocked",
                  "color": "orange",
                  "index": 2
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "not reported",
                  "color": "#8e8e8e",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
