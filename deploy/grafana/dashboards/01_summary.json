{
  "uid": "tesla-summary",
  "title": "Tesla — Summary",
  "tags": [
    "tesla",
    "summary"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "vin",
        "label": "VIN",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT DISTINCT vin AS __text, vin AS __value FROM telemetry ORDER BY 1",
        "refresh": 2
      },
      {
        "name": "units_override",
        "label": "Units",
        "type": "custom",
        "query": "auto,metric,imperial",
        "current": {
          "text": "auto",
          "value": "auto"
        }
      },
      {
        "name": "units_effective",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT CASE WHEN '$units_override'='metric' THEN 'metric' WHEN '$units_override'='imperial' THEN 'imperial' WHEN (SELECT distance_unit FROM vehicle_prefs_pivot WHERE vin = '$vin')='DistanceUnitMiles' THEN 'imperial' ELSE 'metric' END",
        "refresh": 2
      },
      {
        "name": "temp_effective",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "refresh": 2,
        "query": "SELECT CASE WHEN '$units_override'='metric' THEN 'metric' WHEN '$units_override'='imperial' THEN 'imperial' WHEN (SELECT temp_unit FROM vehicle_prefs_pivot WHERE vin = '$vin')='TemperatureUnitFahrenheit' THEN 'imperial' ELSE 'metric' END"
      },
      {
        "name": "speed_unit",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT CASE WHEN '$units_override'='imperial' THEN 'mph' WHEN '$units_override'='metric' THEN 'km/h' WHEN (SELECT distance_unit FROM vehicle_prefs_pivot WHERE vin = '$vin')='DistanceUnitMiles' THEN 'mph' ELSE 'km/h' END",
        "refresh": 2,
        "label": "speed unit",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 9990,
      "panels": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "custom": {
                "align": "left",
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false
              },
              "mappings": [
                {
                  "options": {
                    "f": {
                      "color": "red",
                      "index": 0,
                      "text": "❌ No"
                    },
                    "t": {
                      "color": "green",
                      "index": 1,
                      "text": "✅ Yes"
                    }
                  },
                  "type": "value"
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 24,
            "x": 0,
            "y": 1
          },
          "id": 9991,
          "options": {
            "cellHeight": "sm",
            "footer": {
              "countRows": false,
              "enablePagination": false,
              "fields": "",
              "reducer": [],
              "show": false
            },
            "showHeader": true,
            "sortBy": []
          },
          "pluginVersion": "11.2.0",
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "tesla_timescaledb"
              },
              "format": "table",
              "rawSql": "SELECT model AS \"Model\", model_year AS \"Year\", motor_config AS \"Motor\", has_heat_pump AS \"Heat Pump\", has_air_suspension AS \"Air Suspension\" FROM detect_vehicle_from_vin('$vin')",
              "refId": "A"
            }
          ],
          "title": "Decoded VIN: $vin",
          "type": "table",
          "description": "Vehicle information decoded from the selected VIN using the detect_vehicle_from_vin() database function."
        }
      ],
      "title": "🚗 Vehicle Info",
      "type": "row"
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "State of Charge",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT num_value AS soc FROM telemetry_latest WHERE vin = '$vin' AND field = 'BatteryLevel'"
        }
      ],
      "description": "Latest battery state of charge for the selected VIN."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Range",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "not reported",
                  "color": "#8e8e8e",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Range$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN '$units_effective'='imperial' THEN num_value ELSE num_value*1.609344 END AS \"Range\" FROM telemetry_latest WHERE vin='$vin' AND field='RatedRange'"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN '$units_effective'='imperial' THEN 'lengthmi' ELSE 'lengthkm' END AS unit"
        }
      ],
      "description": "Latest estimated rated range, converted to the effective unit preference.",
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "mappings": [
              {
                "fieldName": "unit",
                "handlerKey": "unit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Charge State",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^state$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT str_value AS state FROM telemetry_latest WHERE vin='$vin' AND field='ChargeState'"
        }
      ],
      "description": "Current charging status reported by the vehicle (e.g. Charging, Complete)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Gear",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^gear$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE replace(str_value, 'ShiftState', '') WHEN 'P' THEN 'Park' WHEN 'D' THEN 'Drive' WHEN 'R' THEN 'Reverse' WHEN 'N' THEN 'Neutral' ELSE replace(str_value, 'ShiftState', '') END AS gear FROM telemetry WHERE vin='$vin' AND field='Gear' AND str_value LIKE 'ShiftState%' AND ts > now() - interval '400 days' ORDER BY ts DESC LIMIT 1"
        }
      ],
      "description": "Current transmission gear selector position.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "not reported",
                  "color": "#8e8e8e",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Speed",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "displayName": "Speed"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT bucket AS time, CASE WHEN '$units_effective'='imperial' THEN avg_v ELSE avg_v*1.609344 END AS speed FROM telemetry_1m WHERE field='VehicleSpeed' AND vin='$vin' AND $__timeFilter(bucket) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN '$units_effective'='imperial' THEN 'velocitymph' ELSE 'velocitykmh' END AS unit"
        }
      ],
      "description": "Latest vehicle speed from the 1-minute aggregated telemetry table.",
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "mappings": [
              {
                "fieldName": "unit",
                "handlerKey": "unit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Power",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(v.num_value * i.num_value / 1000, 0) AS power_kw\nFROM\n  (SELECT num_value FROM telemetry_latest WHERE vin='$vin' AND field='PackVoltage') v,\n  (SELECT num_value FROM telemetry_latest WHERE vin='$vin' AND field='PackCurrent') i"
        }
      ],
      "description": "Latest battery power calculated from pack voltage × pack current."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Outside Temp",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT bucket AS time, to_temp(avg_v, '$temp_effective') AS temp FROM telemetry_1m WHERE field='OutsideTemp' AND vin='$vin' AND $__timeFilter(bucket) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN '$temp_effective'='imperial' THEN 'fahrenheit' ELSE 'celsius' END AS unit"
        }
      ],
      "description": "Latest outside temperature, converted to the effective unit preference.",
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "mappings": [
              {
                "fieldName": "unit",
                "handlerKey": "unit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Speed & Power",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 18,
        "x": 6,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "power_kw"
            },
            "properties": [
              {
                "id": "unit",
                "value": "kwatt"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "speed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Speed (${speed_unit})"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "power_kw"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Power (kW)"
              },
              {
                "id": "unit",
                "value": "kwatt"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, CASE WHEN '$units_effective'='imperial' THEN num_value ELSE num_value * 1.60934 END AS speed\nFROM telemetry\nWHERE field='VehicleSpeed' AND vin='$vin' AND num_value IS NOT NULL AND $__timeFilter(ts)\nORDER BY ts"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT\n  v.bucket AS time,\n  v.avg_v * i.avg_v / 1000 AS power_kw\nFROM telemetry_1m v\nJOIN telemetry_1m i ON v.bucket = i.bucket AND v.vin = i.vin\nWHERE v.field='PackVoltage' AND i.field='PackCurrent'\n  AND v.vin='$vin' AND $__timeFilter(v.bucket)\nORDER BY 1"
        }
      ],
      "description": "Time-series overlay of vehicle speed and battery power."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "TPMS (bar)",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurebar",
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  MAX(CASE WHEN field='TpmsPressureFl' THEN num_value END) AS \"FL\",\n  MAX(CASE WHEN field='TpmsPressureFr' THEN num_value END) AS \"FR\",\n  MAX(CASE WHEN field='TpmsPressureRl' THEN num_value END) AS \"RL\",\n  MAX(CASE WHEN field='TpmsPressureRr' THEN num_value END) AS \"RR\"\nFROM telemetry_latest\nWHERE vin='$vin' AND field IN ('TpmsPressureFl','TpmsPressureFr','TpmsPressureRl','TpmsPressureRr')"
        }
      ],
      "description": "Current tyre pressures for all four wheels."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Battery pack temperatures",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, avg_v AS min_c FROM telemetry_1m WHERE field='ModuleTempMin' AND vin='$vin' AND $__timeFilter(bucket) ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, avg_v AS max_c FROM telemetry_1m WHERE field='ModuleTempMax' AND vin='$vin' AND $__timeFilter(bucket) ORDER BY 1"
        }
      ],
      "description": "Minimum and maximum battery module temperatures over time."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cabin climate",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, avg_v AS inside FROM telemetry_1m WHERE field='InsideTemp' AND vin='$vin' AND $__timeFilter(bucket) ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, avg_v AS outside FROM telemetry_1m WHERE field='OutsideTemp' AND vin='$vin' AND $__timeFilter(bucket) ORDER BY 1"
        },
        {
          "refId": "C",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, avg_v AS setpoint_l FROM telemetry_1m WHERE field='HvacLeftTemperatureRequest' AND vin='$vin' AND $__timeFilter(bucket) ORDER BY 1"
        }
      ],
      "description": "Interior, exterior, and HVAC set-point temperatures over time."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Doors / windows",
      "description": "Composite proto fields are flattened by the dispatcher: DoorState_DriverFront, WindowState_DriverFront, etc.",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^(Doors|Windows)$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  CASE WHEN count(*) FILTER (WHERE field LIKE 'DoorState_%') = 0 THEN NULL\n       WHEN bool_or(field LIKE 'DoorState_%' AND str_value = 'true') THEN 'Open: ' || string_agg(CASE field WHEN 'DoorState_DriverFront' THEN 'driver front' WHEN 'DoorState_PassengerFront' THEN 'passenger front' WHEN 'DoorState_DriverRear' THEN 'driver rear' WHEN 'DoorState_PassengerRear' THEN 'passenger rear' WHEN 'DoorState_TrunkFront' THEN 'frunk' WHEN 'DoorState_TrunkRear' THEN 'boot' ELSE replace(field, 'DoorState_', '') END, ', ') FILTER (WHERE field LIKE 'DoorState_%' AND str_value = 'true')\n       ELSE 'All closed' END AS \"Doors\",\n  CASE WHEN count(*) FILTER (WHERE field LIKE '__Window') = 0 THEN NULL\n       WHEN bool_or(field LIKE '__Window' AND str_value <> 'WindowStateClosed') THEN 'Open: ' || string_agg(CASE field WHEN 'FdWindow' THEN 'driver front' WHEN 'FpWindow' THEN 'passenger front' WHEN 'RdWindow' THEN 'driver rear' WHEN 'RpWindow' THEN 'passenger rear' END || CASE WHEN str_value = 'WindowStatePartiallyOpen' THEN ' (partly)' ELSE '' END, ', ') FILTER (WHERE field LIKE '__Window' AND str_value <> 'WindowStateClosed')\n       ELSE 'All closed' END AS \"Windows\"\nFROM telemetry_latest\nWHERE vin='$vin' AND (field LIKE 'DoorState_%' OR field IN ('FdWindow','FpWindow','RdWindow','RpWindow'))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "not reported",
          "mappings": [
            {
              "type": "value",
              "options": {
                "All closed": {
                  "text": "All closed",
                  "color": "green",
