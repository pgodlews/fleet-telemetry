        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT field, str_value FROM telemetry_latest WHERE vin='$vin' AND field IN ('Locked','SentryMode','ValetModeEnabled','GuestModeEnabled','PinToDriveEnabled','ServiceMode','LightsHazardsActive','BrakePedal','DriverSeatBelt','DriverSeatOccupied')"
        }
