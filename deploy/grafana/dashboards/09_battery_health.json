{
  "uid": "tesla-battery-health",
  "title": "Tesla — Battery Health",
  "tags": [
    "tesla",
    "battery",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "vin",
        "label": "VIN",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT DISTINCT vin AS __text, vin AS __value FROM telemetry ORDER BY 1",
        "refresh": 2
      },
      {
        "name": "dist_effective",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT COALESCE(MAX(CASE WHEN distance_unit='DistanceUnitMiles' THEN 'imperial' ELSE 'metric' END),'imperial') FROM vehicle_prefs_pivot WHERE vin='$vin'",
        "refresh": 2,
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 9990,
      "panels": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "custom": {
                "align": "left",
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false
              },
              "mappings": [
                {
                  "options": {
                    "f": {
                      "color": "red",
                      "index": 0,
                      "text": "❌ No"
                    },
                    "t": {
                      "color": "green",
                      "index": 1,
                      "text": "✅ Yes"
                    }
                  },
                  "type": "value"
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 24,
            "x": 0,
            "y": 1
          },
          "id": 9991,
          "options": {
            "cellHeight": "sm",
            "footer": {
              "countRows": false,
              "enablePagination": false,
              "fields": "",
              "reducer": [],
              "show": false
            },
            "showHeader": true,
            "sortBy": []
          },
          "pluginVersion": "11.2.0",
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "tesla_timescaledb"
              },
              "format": "table",
              "rawSql": "SELECT model AS \"Model\", model_year AS \"Year\", motor_config AS \"Motor\", has_heat_pump AS \"Heat Pump\", has_air_suspension AS \"Air Suspension\" FROM detect_vehicle_from_vin('$vin')",
              "refId": "A"
            }
          ],
          "title": "Decoded VIN: $vin",
          "type": "table",
          "description": "Vehicle information decoded from the selected VIN using the detect_vehicle_from_vin() database function."
        }
      ],
      "title": "🚗 Vehicle Info",
      "type": "row"
    },
    {
      "id": null,
      "type": "row",
      "title": "🔋 Battery Health Overview",
