{
  "uid": "tesla-battery-health",
  "title": "Tesla — Battery Health",
  "tags": [
    "tesla",
    "battery",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "vin",
        "label": "VIN",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT DISTINCT vin AS __text, vin AS __value FROM telemetry ORDER BY 1",
        "refresh": 2
      },
      {
        "name": "dist_effective",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT COALESCE(MAX(CASE WHEN distance_unit='DistanceUnitMiles' THEN 'imperial' ELSE 'metric' END),'imperial') FROM vehicle_prefs_pivot WHERE vin='$vin'",
        "refresh": 2,
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
