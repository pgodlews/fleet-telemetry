        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "id": null,
      "type": "stat",
      "title": "Overall Status",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "description": "Combined battery health status. CRITICAL = immediate service. Fixed in migration 028: max_alert_severity now ranks CRITICAL/URGENT above WARNING (previously alphabetical MAX(severity) could mask a real CRITICAL fault behind an active WARNING), so BATTERY_SERVICE_REQUIRED can now genuinely surface here.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "NORMAL": {
                  "color": "green",
                  "index": 0,
                  "text": "NORMAL"
                },
                "BATTERY_IMBALANCE_DETECTED": {
                  "color": "yellow",
                  "index": 1,
                  "text": "IMBALANCE DETECTED"
                },
                "BATTERY_CAPACITY_DEGRADED": {
                  "color": "orange",
                  "index": 2,
                  "text": "CAPACITY DEGRADED"
                },
                "BATTERY_SERVICE_RECOMMENDED": {
                  "color": "red",
                  "index": 3,
                  "text": "SERVICE RECOMMENDED (URGENT)"
                },
                "BATTERY_SERVICE_REQUIRED": {
                  "color": "dark-red",
                  "index": 4,
                  "text": "SERVICE REQUIRED (CRITICAL)"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": ""
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^overall_status$/",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT overall_status FROM battery_health_summary WHERE vin = '$vin'",
          "format": "table"
        }
      ]
    },
