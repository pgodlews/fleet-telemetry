      "gridPos": {
        "h": 20,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 51.505,
          "lon": -0.09,
          "zoom": 11
        },
        "controls": {
          "showZoom": true,
          "showAttribution": true,
          "showScale": true,
          "mouseWheelZoom": true
