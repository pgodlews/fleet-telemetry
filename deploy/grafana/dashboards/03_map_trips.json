      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT vin, trip_id, started AT TIME ZONE 'Europe/London' AS \"Start\", ROUND(EXTRACT(EPOCH FROM duration)/60) AS mins, CASE WHEN '$dist_effective'='imperial' THEN ROUND((distance_km * 0.621371)::numeric, 1) ELSE distance_km END AS distance_km, CASE WHEN '$dist_effective'='imperial' THEN max_speed_mph ELSE ROUND((max_speed_mph * 1.60934)::numeric, 1) END AS max_speed_mph, CASE WHEN '$dist_effective'='imperial' THEN avg_speed_mph ELSE ROUND((avg_speed_mph * 1.60934)::numeric, 1) END AS avg_speed_mph, soc_start_pct AS soc_start, soc_end_pct AS soc_end, soc_used_pct AS soc_drop, kwh_used, CASE WHEN '$dist_effective'='imperial' THEN ROUND((wh_per_km * 1.60934)::numeric, 0) ELSE wh_per_km END AS wh_per_km, EXTRACT(EPOCH FROM started)*1000 AS started_epoch, EXTRACT(EPOCH FROM ended)*1000 AS ended_epoch FROM trips WHERE vin='$vin' AND started > NOW() - INTERVAL '30 days' ORDER BY started DESC LIMIT 50"
        }
      ],
      "description": "List of recent trips; click a row to zoom the map to that time range."
    },
