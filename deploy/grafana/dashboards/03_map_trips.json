        "basemap": {
          "type": "carto",
          "config": {
            "theme": "dark"
          }
        },
        "layers": [
          {
            "type": "route",
            "name": "Track",
            "config": {
              "showLegend": false,
              "size": {
                "fixed": 3
              },
              "color": {
                "fixed": "#e8332b"
