            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts AS time, ST_Y(geo_value::geometry) AS latitude, ST_X(geo_value::geometry) AS longitude FROM telemetry WHERE vin='$vin' AND field='Location' AND geo_value IS NOT NULL AND $__timeFilter(ts) ORDER BY ts"
        }
      ],
      "description": "Map showing the vehicle's driven route from GPS location points."
    },
