  "templating": {
    "list": [
      {
        "name": "vin",
        "label": "VIN",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT DISTINCT vin AS __text, vin AS __value FROM telemetry ORDER BY 1",
        "refresh": 2
      }
    ]
  },
