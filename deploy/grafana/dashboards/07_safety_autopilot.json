          "gridPos": {
            "h": 4,
            "w": 24,
            "x": 0,
            "y": 1
          },
          "id": 9991,
          "options": {
            "cellHeight": "sm",
            "footer": {
              "countRows": false,
              "enablePagination": false,
              "fields": "",
              "reducer": [],
              "show": false
            },
            "showHeader": true,
            "sortBy": []
          },
          "pluginVersion": "11.2.0",
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "tesla_timescaledb"
              },
              "format": "table",
              "rawSql": "SELECT model AS \"Model\", model_year AS \"Year\", motor_config AS \"Motor\", has_heat_pump AS \"Heat Pump\", has_air_suspension AS \"Air Suspension\" FROM detect_vehicle_from_vin('$vin')",
              "refId": "A"
            }
          ],
          "title": "Decoded VIN: $vin",
          "type": "table",
          "description": "Vehicle information decoded from the selected VIN using the detect_vehicle_from_vin() database function."
        }
      ],
      "title": "🚗 Vehicle Info",
      "type": "row"
    },
    {
      "id": null,
      "type": "row",
      "title": "🚗 Cruise & Speed",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cruise Set Speed vs Actual",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "description": "Comparison of autopilot cruise set speed vs actual vehicle speed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisColorMode": "text",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT \n  $__timeGroup(ts, '30s') as time,\n  MAX(CASE WHEN field='VehicleSpeed' THEN CASE WHEN '$dist_effective'='imperial' THEN num_value ELSE num_value*1.60934 END END) as \"Actual Speed\",\n  MAX(CASE WHEN field='CruiseSetSpeed' THEN CASE WHEN '$dist_effective'='imperial' THEN num_value ELSE num_value*1.60934 END END) as \"Cruise Set\"\nFROM telemetry \nWHERE field IN ('VehicleSpeed','CruiseSetSpeed') AND vin='$vin' AND num_value IS NOT NULL AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": null,
      "type": "row",
      "title": "🛡️ Safety Systems",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "table",
      "title": "Safety Features State",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "description": "Current state of autopilot and safety features.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "field",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT \n  field as \"Feature\",\n  str_value as \"State\",\n  ts as \"Last Updated\"\nFROM telemetry_latest\nWHERE vin='$vin' AND field IN (\n  'LaneDepartureAvoidance',\n  'ForwardCollisionWarning',\n  'AutomaticEmergencyBrakingOff',\n  'BlindSpotCollisionWarningChime',\n  'SpeedLimitWarning',\n  'SpeedLimitMode',\n  'EmergencyLaneDepartureAvoidance'\n)\nORDER BY field",
          "format": "table"
        }
      ]
    },
    {
