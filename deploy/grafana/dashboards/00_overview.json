  "title": "Tesla — Overview",
  "uid": "tesla-overview",
  "version": 1,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "name": "vin",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT DISTINCT vin FROM telemetry ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "label": "VIN"
      },
      {
        "name": "dist_unit",
        "label": "Distance",
        "type": "custom",
        "query": "auto,metric,imperial",
        "current": {
          "text": "auto",
          "value": "auto"
        }
      },
      {
        "name": "temp_unit",
        "label": "Temperature",
        "type": "custom",
        "query": "auto,celsius,fahrenheit",
        "current": {
          "text": "auto",
          "value": "auto"
        }
      },
      {
        "name": "pressure_unit",
        "label": "Pressure",
        "type": "custom",
        "query": "auto,bar,psi",
        "current": {
          "text": "auto",
          "value": "auto"
        }
      },
      {
        "name": "dist_effective",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT CASE WHEN '$dist_unit'='metric' THEN 'metric' WHEN '$dist_unit'='imperial' THEN 'imperial' WHEN (SELECT COALESCE(distance_unit, 'DistanceUnitKm') FROM vehicle_prefs_pivot WHERE vin = '$vin')='DistanceUnitMiles' THEN 'imperial' ELSE 'metric' END",
        "refresh": 2
      },
      {
        "name": "temp_effective",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT CASE WHEN '$temp_unit'='fahrenheit' THEN 'imperial' WHEN '$temp_unit'='celsius' THEN 'metric' WHEN (SELECT COALESCE(temp_unit, 'TemperatureUnitC') FROM vehicle_prefs_pivot WHERE vin = '$vin')='TemperatureUnitFahrenheit' THEN 'imperial' ELSE 'metric' END",
        "refresh": 2
      },
      {
        "name": "pressure_effective",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "postgres",
          "uid": "tesla_timescaledb"
        },
        "query": "SELECT CASE WHEN '$pressure_unit'='psi' THEN 'PressureUnitPsi' WHEN '$pressure_unit'='bar' THEN 'PressureUnitBar' WHEN (SELECT COALESCE(tire_unit, 'PressureUnitBar') FROM vehicle_prefs_pivot WHERE vin = '$vin')='PressureUnitPsi' THEN 'PressureUnitPsi' ELSE 'PressureUnitBar' END",
        "refresh": 2
      }
    ]
  }
