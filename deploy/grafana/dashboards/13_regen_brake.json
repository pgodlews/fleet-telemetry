      "title": "Brake Pads (record)",
      "datasource": {
        "type": "postgres",
        "uid": "tesla_timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "description": "Pad history from the service log (bot: brake_pads, brake_inspection; owner-confirmed original pads). Telemetry has no pad-wear signal, so no wear percentage is shown; regen-heavy cars commonly exceed 100k mi on a set. Pad condition is checked at the periodic safety inspection.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "format": "table",
          "rawSql": "SELECT CASE wear_basis WHEN 'SINCE_PAD_REPLACEMENT' THEN 'Replaced ' || to_char(pad_replaced_at, 'YYYY-MM-DD') WHEN 'ORIGINAL_PADS_CONFIRMED' THEN 'Original (owner-confirmed)' ELSE 'No record' END AS \"Pads\", CASE WHEN '$dist_effective' = 'imperial' THEN pad_miles ELSE ROUND(pad_miles * 1.60934) END AS \"Distance on this set\", to_char(last_inspection_at, 'YYYY-MM-DD') AS \"Last checked\", brake_style_assessment AS \"Regen use\" FROM brake_wear_estimate WHERE vin = '$vin'"
        }
      ]
    },
