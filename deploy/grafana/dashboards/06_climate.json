      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT ts AS time, GREATEST(sleep_hours - dcdc_cycling_sleep_hours - dcdc_always_on_sleep_hours, 0) AS \"Clean sleep hours\", dcdc_cycling_sleep_hours AS \"Cycling hours\", dcdc_always_on_sleep_hours AS \"Always-on hours\" FROM low_voltage_diagnostics WHERE vin = '$vin' AND $__timeFilter(ts) ORDER BY ts",
