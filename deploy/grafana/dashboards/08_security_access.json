          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT \n  $__timeGroup(ts, '1m') as time,\n  MAX(CASE WHEN field='DoorState_DriverFront' THEN CASE WHEN str_value='true' THEN 1 ELSE 0 END END) as \"Driver\",\n  MAX(CASE WHEN field='DoorState_PassengerFront' THEN CASE WHEN str_value='true' THEN 1 ELSE 0 END END) as \"Passenger\",\n  MAX(CASE WHEN field='DoorState_DriverRear' THEN CASE WHEN str_value='true' THEN 1 ELSE 0 END END) as \"Rear Driver\",\n  MAX(CASE WHEN field='DoorState_PassengerRear' THEN CASE WHEN str_value='true' THEN 1 ELSE 0 END END) as \"Rear Passenger\",\n  MAX(CASE WHEN field='DoorState_TrunkFront' THEN CASE WHEN str_value='true' THEN 1 ELSE 0 END END) as \"Frunk\",\n  MAX(CASE WHEN field='DoorState_TrunkRear' THEN CASE WHEN str_value='true' THEN 1 ELSE 0 END END) as \"Trunk\"\nFROM telemetry \nWHERE field LIKE 'DoorState_%%' AND vin='$vin' AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
