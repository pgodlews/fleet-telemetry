          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT \n  $__timeGroup(ts, '1m') as time,\n  MAX(CASE WHEN field='FdWindow' THEN CASE WHEN str_value='WindowStateClosed' THEN 0 WHEN str_value='WindowStatePartiallyOpen' THEN 1 ELSE 2 END END) as \"Driver\",\n  MAX(CASE WHEN field='FpWindow' THEN CASE WHEN str_value='WindowStateClosed' THEN 0 WHEN str_value='WindowStatePartiallyOpen' THEN 1 ELSE 2 END END) as \"Passenger\",\n  MAX(CASE WHEN field='RdWindow' THEN CASE WHEN str_value='WindowStateClosed' THEN 0 WHEN str_value='WindowStatePartiallyOpen' THEN 1 ELSE 2 END END) as \"Rear Driver\",\n  MAX(CASE WHEN field='RpWindow' THEN CASE WHEN str_value='WindowStateClosed' THEN 0 WHEN str_value='WindowStatePartiallyOpen' THEN 1 ELSE 2 END END) as \"Rear Passenger\"\nFROM telemetry \nWHERE field IN ('FdWindow','FpWindow','RdWindow','RpWindow') \n  AND vin='$vin' AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
