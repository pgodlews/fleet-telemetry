          "rawSql": "SELECT \n  ts as time,\n  CASE WHEN str_value='true' THEN 1 ELSE 0 END as \"Locked\"\nFROM telemetry \nWHERE field='Locked' AND vin='$vin' AND $__timeFilter(ts)\nORDER BY ts",
          "format": "time_series"
        }
      ]
    },
