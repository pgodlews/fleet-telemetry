          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT \n  MAX(CASE WHEN field='ValetModeEnabled' THEN CASE WHEN str_value='true' THEN 'ON' ELSE 'OFF' END END) as \"Valet Mode\",\n  MAX(CASE WHEN field='PinToDriveEnabled' THEN CASE WHEN str_value='true' THEN 'ON' ELSE 'OFF' END END) as \"Pin to Drive\",\n  MAX(CASE WHEN field='GuestModeEnabled' THEN CASE WHEN str_value='true' THEN 'ON' ELSE 'OFF' END END) as \"Guest Mode\"\nFROM telemetry_latest \nWHERE vin='$vin'",
          "format": "table"
        }
      ]
