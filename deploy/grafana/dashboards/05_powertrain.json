        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tesla_timescaledb"
          },
          "rawSql": "SELECT time_bucket('30s', v.ts) AS time,\n  AVG(v.num_value)*AVG(i.num_value)/1000 AS \"Power kW\"\nFROM telemetry v\nJOIN telemetry i ON time_bucket('30s',v.ts)=time_bucket('30s',i.ts) AND v.vin=i.vin\nWHERE v.field='PackVoltage' AND i.field='PackCurrent'\n  AND v.vin='$vin' AND $__timeFilter(v.ts)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "description": "Battery power over time calculated from pack voltage × pack current."
    },
