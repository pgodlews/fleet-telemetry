# ==============================================================================
# Tesla Fleet Telemetry - Deployment Environment Variables
# ==============================================================================

# PostgreSQL superuser password (used by TimescaleDB)
POSTGRES_PASSWORD=change_this_postgres_password

# Grafana admin user password (for web UI login)
GF_ADMIN_PASSWORD=change_this_admin_password

# Grafana read-only database user password (used by the datasource to connect to TimescaleDB)
GF_TESLA_DB_PASSWORD=change_this_grafana_ro_password

# Host for Grafana to reach TimescaleDB.
# - If running both in Docker Compose: timescaledb:5432
# - If running Grafana remotely via an autossh tunnel: 172.17.0.1:5433
GF_TESLA_DB_HOST=timescaledb:5432
